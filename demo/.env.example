# Server-only. Copy only if .env does not already exist; never overwrite a real key.
GEMINI_API_KEY=replace_with_your_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=5000
PORT=4317
# Recorded by npm run check:gemini -- --confirm-free-project=PROJECT_ID_OR_NAME --confirm-free-model=gemini-3.1-flash-lite
# Confirm the key belongs to a Free-tier project in Google AI Studio first.
# Recheck the exact model's published free-tier eligibility and project quota.
# Saved operator confirmation binds to this key and model; it is not a live billing check.
# Reconfirm after any project, key, model, or billing-tier change.
GEMINI_FREE_TIER_PROJECT=
GEMINI_FREE_TIER_MODEL=
GEMINI_FREE_TIER_KEY_SHA256=
GEMINI_FREE_TIER_VERIFIED_AT=
