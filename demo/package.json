{
  "name": "humanities-language-support-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "npm run build:input && tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts --production",
    "test": "node --import tsx --test tests/*.test.ts",
    "evaluate": "node --env-file-if-exists=.env --import tsx scripts/evaluate.ts",
    "check:gemini": "node --env-file-if-exists=.env --import tsx scripts/check-gemini.ts",
    "build:input": "tailwindcss -c tailwind.input.config.cjs -i src/prompt-utilities.input.css -o src/prompt-utilities.css --minify",
    "predev": "npm run build:input",
    "check:language": "node --import tsx scripts/check-language.ts",
    "test:language-ui": "node --import tsx scripts/ui-language-fixture.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "clsx": "^2.1.1",
    "motion": "^14.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
